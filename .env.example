# MarginPulse configuration. Copy to .env only if you need to change defaults.
# Defaults run fully offline: simulated Uber Ads, mock POS, deterministic investigator.
# NEVER commit real values. Secrets are read server-side only.

PORT=8787
HOST=127.0.0.1
DB_PATH=data/marginpulse.db
# DATABASE_PATH takes precedence over DB_PATH (V3 CH-22). In the container image it is /data/marginpulse.db.
# DATABASE_PATH=
# NODE_ENV=production turns on fail-closed start-up checks and turns off automatic seeding (see docs/DEPLOYMENT.md).
# NODE_ENV=

# --- Uber Ads provider -------------------------------------------------------
# SIMULATED (default) | SANDBOX | LIVE. Non-simulated modes fail closed until configured.
ADS_MODE=SIMULATED
# Required for SANDBOX/LIVE. Base URL of the Uber Ads API you have been granted (TO_VERIFY with Uber).
UBER_ADS_BASE_URL=
# OAuth access token with ads.campaigns.read and ads.campaigns.write. Dummy value below.
UBER_ADS_TOKEN=replace-with-oauth-access-token
# LIVE writes additionally require this explicit switch.
ALLOW_LIVE_UBER_WRITES=false
ADS_TIMEOUT_MS=3000
READBACK_ATTEMPTS=3
READBACK_INTERVAL_MS=400

# --- POS -------------------------------------------------------------------
# Shared HMAC secret for POS webhooks (mock POS signs with the same value).
POS_WEBHOOK_SECRET=replace-with-long-random-secret
# Optional: point the POS adapter / webhook at another host.
POS_BASE_URL=
WEBHOOK_URL=

# --- Investigator ------------------------------------------------------------
# fixture (default, deterministic, no model) | llm (requires both values below)
INVESTIGATOR=fixture
ANTHROPIC_API_KEY=
# No default model is assumed; set the model id you are entitled to use.
LLM_MODEL=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Visitor access gate (V3 CH-20) ----------------------------------------
# A four-digit convenience gate for a hosted portfolio demo; not account security.
# On by default when NODE_ENV=production (and cannot be turned off there); off by default elsewhere.
# ACCESS_GATE=on
# Exactly four digits. Runtime secret only: never a VITE_ variable, never committed.
# ACCESS_PIN=
# Random, at least 32 characters (openssl rand -hex 32). Signs the session cookie.
# SESSION_SECRET=
# Session length in minutes (5 to 1440). Default 120.
# ACCESS_SESSION_TTL_MINUTES=120
# Unset: trust no forwarded headers. Set to 1 behind exactly one reverse proxy (the panel's proxy).
# TRUST_PROXY=

# --- Analytics (V3 CH-21) ----------------------------------------------------
# Optional public Microsoft Clarity project ID (from your Clarity dashboard). Not a secret.
# Needed at build time (UI bundle) and at run time (the server adds Clarity's domains to the CSP).
# Empty = no analytics. Nothing loads until a visitor chooses "Allow"; never on the access gate.
# VITE_CLARITY_PROJECT_ID=
# Analytics stays off on localhost unless this is true.
# VITE_CLARITY_ALLOW_LOCAL=false
